# ====================================================================
# EXPRESS CARGO - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your actual deployment values.
# NEVER commit real credentials or production .env files to Git repositories.
# ====================================================================

# --------------------------------------------------------------------
# Server & Runtime Configuration
# --------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# --------------------------------------------------------------------
# Database Configuration (MongoDB Atlas Connection URI)
# --------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_NAME>.mongodb.net/<DB_NAME>?retryWrites=true&w=majority

# --------------------------------------------------------------------
# JSON Web Token (JWT) Secrets
# --------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_access_token_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# Client Frontend URL (CORS Whitelist, comma-separated)
# --------------------------------------------------------------------
CLIENT_URL=https://express-cargo.ltd,http://localhost:5000

# --------------------------------------------------------------------
# Resend & Email Configuration
# --------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Express-Cargo <no_reply@vertexcapitals.ltd>
EMAIL_FROM_NAME=Express-Cargo
EMAIL_FROM_ADDRESS=no_reply@vertexcapitals.ltd
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_FROM="Express-Cargo" <no_reply@vertexcapitals.ltd>

# --------------------------------------------------------------------
# Cloudinary Storage Configuration (Documents, Cargo Photos, Proofs)
# --------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------------------
# Rate Limiting & Administrative Defaults
# --------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
